{
  "name": "isla-suds",
  "private": true,
  "sideEffects": false,
  "version": "2025.7.3",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "PORTLESS_HTTPS=0 PORTLESS_PORT=1355 portless run sh -c 'shopify hydrogen dev --codegen --port $PORT --inspector-port $((PORT+1000))'",
    "preview": "PORTLESS_HTTPS=0 PORTLESS_PORT=1355 portless isla-suds-preview sh -c 'shopify hydrogen preview --build --port $PORT --inspector-port $((PORT+1000))'",
    "serve:lhci": "PORTLESS_HTTPS=0 PORTLESS_PORT=1355 portless isla-suds-preview sh -c 'shopify hydrogen preview --port $PORT --inspector-port $((PORT+1000))'",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "test": "vitest run",
    "test:smoke:build": "node scripts/smoke-test-build.mjs",
    "test:smoke:typecheck": "node scripts/smoke-test-typecheck.mjs",
    "test:smoke:dev": "node scripts/smoke-test-dev-server.mjs",
    "lighthouse:ci": "pnpm build && pnpm lighthouse:desktop && pnpm lighthouse:mobile",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.cjs",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.cjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "test:a11y": "playwright test --project=accessibility",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:p0": "playwright test tests/e2e --grep \"\\[P0\\]\"",
    "test:e2e:p1": "playwright test tests/e2e --grep \"\\[P0\\]|\\[P1\\]\"",
    "test:e2e:wholesale": "playwright test tests/e2e/wholesale-reorder.spec.ts",
    "test:integration": "playwright test tests/integration",
    "test:integration:wholesale": "playwright test tests/integration/wholesale-reorder.spec.ts",
    "test:perf": "playwright test tests/performance",
    "test:perf:wholesale": "playwright test tests/performance/wholesale-reorder.perf.spec.ts",
    "test:component": "vitest run tests/component",
    "test:wholesale": "playwright test tests/**/*wholesale*.spec.ts",
    "test:unit:all": "vitest run"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@responsive-image/react": "^1.1.6",
    "@shopify/hydrogen": "2026.10.0",
    "@types/leaflet": "^1.9.22",
    "@types/sanitize-html": "^2.16.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "gsap": "^3.15.0",
    "isbot": "^5.2.2",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "5.0.0",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "resend": "^6.32.1",
    "sanitize-html": "^2.18.0",
    "set-cookie-parser": "^3.1.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "7.4.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "7.18.4",
    "@react-router/fs-routes": "7.18.4",
    "@responsive-image/core": "^2.1.0",
    "@responsive-image/vite-plugin": "^3.0.1",
    "@shopify/cli": "4.9.3",
    "@shopify/hydrogen-codegen": "^0.3.3",
    "@shopify/hydrogen-react": "2026.4.4",
    "@shopify/mini-oxygen": "^4.2.3",
    "@shopify/oxygen-workers-types": "^4.2.0",
    "@shopify/prettier-config": "^1.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "graphql-config": "^5.1.8",
    "jsdom": "^27.4.0",
    "lighthouse": "^13.5.0",
    "playwright-core": "^1.64.0",
    "portless": "^0.15.7",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.11.2",
  "browserslist": [
    "defaults"
  ]
}